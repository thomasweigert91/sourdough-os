# Neon-Zugangsdaten. Kopie als .env.local anlegen und Werte eintragen (nicht einchecken).
# Gepoolte Verbindung (App, @/db)
DATABASE_URL=
# Direkte Verbindung (drizzle-kit, Migrationen); optional, Fallback ist DATABASE_URL
DATABASE_URL_UNPOOLED=

# Better-Auth. Secret zufällig erzeugen, mindestens 32 Zeichen (z. B. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Basis-URL der App, absolute http(s)-URL (lokal: http://localhost:3000).
BETTER_AUTH_URL=
# Optionale weitere erlaubte Origins, kommagetrennt (z. B. eigene Domain).
# Auf Vercel sind VERCEL_URL und VERCEL_BRANCH_URL automatisch erlaubt.
BETTER_AUTH_TRUSTED_ORIGINS=
# Optionale OAuth-Provider: Ein Provider ist nur aktiv, wenn ID und Secret gesetzt sind.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
